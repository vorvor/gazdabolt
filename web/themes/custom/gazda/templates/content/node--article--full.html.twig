{#
/**
 * @file
 * Full Article display for the Gazda theme.
 */
#}
<article{{ attributes.addClass('gazda-article') }}>
  {{ title_prefix }}
  <h1{{ title_attributes.addClass('gazda-article__title') }}>{{ label }}</h1>
  {{ title_suffix }}
  <div{{ content_attributes.addClass('gazda-article__content') }}>
    <div class="gazda-article__image">{{ content.field_image }}</div>
    <div class="gazda-article__date">{{ content.field_date }}</div>
    <div class="gazda-article__description">{{ content.field_description }}</div>
  </div>
</article>
