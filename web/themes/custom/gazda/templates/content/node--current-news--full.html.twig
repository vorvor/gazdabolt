{#
/**
 * @file
 * Full Current news display for the Gazda theme.
 */
#}
<article{{ attributes.addClass('gazda-current-news') }}>
  <div{{ content_attributes.addClass('gazda-current-news__hero') }}>
    <div class="gazda-current-news__image">{{ content.field_image }}</div>
    <div class="gazda-current-news__overlay">
      <div class="gazda-current-news__date">{{ content.field_date }}</div>
      {{ title_prefix }}
      <h1{{ title_attributes.addClass('gazda-current-news__title') }}>{{ label }}</h1>
      {{ title_suffix }}
      <div class="gazda-current-news__description">{{ content.field_description }}</div>
    </div>
  </div>
</article>
