{#
/**
 * @file
 * Gazdabolt landing page adapted from the supplied responsive HTML draft.
 */
#}
{% extends '@gazda/layout/page.html.twig' %}

{% block main %}
<main id="main-content">
  {{ page.highlighted }}
  {{ page.help }}
  <div id="content">
    <section id="hero" aria-labelledby="hero-title">
      <div id="hero-image"><img src="{{ asset_path }}/images/hero-image-woman-2.png" alt="" fetchpriority="high"></div>
      <div id="hero-text">
        <h1 id="hero-title">{{ 'Minden, ami'|t }}<br>{{ 'a kerthez kell.'|t }}</h1>
        <h2>{{ 'Szentendrén - egy helyen.'|t }}</h2>
        <p>{{ 'Kertészeti termékek, vetőmagok, vegyszerek, műhelyfelszerelés - és sok más. Szakértelemmel és sok szeretettel.'|t }}</p>
      </div>
    </section>

    <section id="introduction" aria-label="{{ 'About Gazdabolt'|t }}">
      {% if gazda_page_edit_url %}<a class="gazda-quick-edit" href="{{ gazda_page_edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ 'introduction'|t }}</span></a>{% endif %}
      <div class="text">{{ page.content }}</div>
      <div class="icons" aria-label="{{ 'Gazdabolt in numbers'|t }}">
        <div class="block"><div class="icon"><img src="{{ asset_path }}/images/icons/clock.png" alt=""></div><div class="text"><strong>45</strong><span>{{ 'év tapasztalat'|t }}</span></div></div>
        <div class="block"><div class="icon"><img src="{{ asset_path }}/images/icons/gardening.png" alt=""></div><div class="text"><strong>4000+</strong><span>{{ 'termék'|t }}</span></div></div>
        <div class="block"><div class="icon"><img src="{{ asset_path }}/images/icons/user.png" alt=""></div><div class="text"><strong>10000+</strong><span>{{ 'elégedett vásárló'|t }}</span></div></div>
      </div>
    </section>

    <div class="separator" role="heading" aria-level="2"><div class="separator-line"></div><div class="separator-icon"><img src="{{ asset_path }}/images/separators/sep-tomato-2.png" alt=""></div><div class="separator-text">{{ 'Termékkategóriák'|t }}</div><div class="separator-line"></div></div>
    <section id="categories" aria-label="{{ 'Product categories'|t }}">
      {% for category in gazda_categories %}
        <article id="category-{{ category.id }}" class="category">
          {% if category.edit_url %}<a class="gazda-quick-edit" href="{{ category.edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ category.name }}</span></a>{% endif %}
          <a class="category-link" href="{{ category.url }}">{{ category.image }}<div class="cat-label">{{ category.name }}</div></a>
        </article>
      {% endfor %}
    </section>

    {% if gazda_discount %}
      <section id="discount" aria-label="{{ 'Current discount'|t }}">
        {% if gazda_discount.edit_url %}<a class="gazda-quick-edit" href="{{ gazda_discount.edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ 'current discount'|t }}</span></a>{% endif %}
        <div id="discount-img">{{ gazda_discount.image }}</div>
        <div id="discount-text"><div id="discount-subtitle">{{ gazda_discount.rate }}% {{ 'kedvezmény'|t }}</div><div id="discount-title">{{ gazda_discount.description }}</div></div>
        <div id="discount-dates">
          <time class="date" datetime="{{ gazda_discount.date_from.raw }}"><span class="date-label">{{ 'kezdet'|t }}</span><span class="date-value"><span class="date-value-year-month">{{ gazda_discount.date_from.year_month }}</span><span class="date-value-day">{{ gazda_discount.date_from.day }}</span></span></time>
          <time class="date" datetime="{{ gazda_discount.date_to.raw }}"><span class="date-label">{{ 'vége'|t }}</span><span class="date-value"><span class="date-value-year-month">{{ gazda_discount.date_to.year_month }}</span><span class="date-value-day">{{ gazda_discount.date_to.day }}</span></span></time>
        </div>
      </section>
    {% endif %}

    <div class="separator" role="heading" aria-level="2"><div class="separator-line"></div><div class="separator-icon"><img src="{{ asset_path }}/images/separators/sep-saw-2.png" alt=""></div><div class="separator-text">{{ 'Népszerű'|t }}</div><div class="separator-line"></div></div>
    <section id="top-products" aria-label="{{ 'Popular products'|t }}">
      <button class="arrow-wrapper" type="button" aria-label="{{ 'Previous products'|t }}" aria-controls="products-slider"><span class="arrow" aria-hidden="true"></span></button>
      <div id="products-slider">
        {% for product in gazda_products %}<article id="product-{{ product.id }}" class="product">{% if product.edit_url %}<a class="gazda-quick-edit" href="{{ product.edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ product.title }}</span></a>{% endif %}<div class="product-image">{{ product.image }}</div><h3 class="product-name">{{ product.title }}</h3><div class="product-desc">{{ product.description }}</div></article>{% endfor %}
      </div>
      <button class="arrow-wrapper arrow-wrapper-right" type="button" aria-label="{{ 'Next products'|t }}" aria-controls="products-slider"><span class="arrow arrow-right" aria-hidden="true"></span></button>
    </section>

    {% if gazda_current_news %}
      <div class="separator" role="heading" aria-level="2"><div class="separator-line"></div><div class="separator-icon"><img src="{{ asset_path }}/images/separators/sep-plant-2.png" alt=""></div><div class="separator-text">{{ 'Aktuális'|t }}</div><div class="separator-line"></div></div>
      <section id="actual-wrapper" aria-label="{{ 'Seasonal advice'|t }}">
        {% set advice_month = gazda_current_news|first %}
        <div class="actual-subtitle"><time datetime="{{ advice_month.date_raw }}">{{ advice_month.month }}</time></div>
        <div id="actual">
          {% for advice in gazda_current_news %}
            <article id="actual-advice-{{ advice.id }}" class="actual-advice">
              {% if advice.edit_url %}<a class="gazda-quick-edit" href="{{ advice.edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ advice.title }}</span></a>{% endif %}
              <div class="actual-image">{{ advice.image }}</div>
              <div class="actual-text">
                <h2 class="actual-title">{{ advice.title }}</h2>
                <div class="actual-desc">{{ advice.description }}</div>
                {% if advice.url %}
                  <a class="actual-products-link" href="{{ advice.url }}">{{ 'Bővebben'|t }}<span aria-hidden="true">→</span></a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if gazda_news %}
      <div class="separator" role="heading" aria-level="2"><div class="separator-line"></div><div class="separator-icon"><img src="{{ asset_path }}/images/separators/sep-leaf-2.png" alt=""></div><div class="separator-text">{{ 'Friss hírek'|t }}</div><div class="separator-line"></div></div>
      <section id="news-wrapper" aria-label="{{ 'Latest news'|t }}">
        <article id="news">
          {% if gazda_news.edit_url %}<a class="gazda-quick-edit" href="{{ gazda_news.edit_url }}">{{ 'Edit'|t }} <span class="visually-hidden">{{ gazda_news.title }}</span></a>{% endif %}
          <div class="news-col-1"><a href="{{ gazda_news.url }}">{{ gazda_news.image }}</a></div>
          <div class="news-col-2">
            <div class="news-header"><div class="left">{{ 'Újdonság'|t }}</div><time class="right" datetime="{{ gazda_news.date_raw }}">{{ gazda_news.date_display }}</time></div>
            <h2 class="news-title"><a href="{{ gazda_news.url }}">{{ gazda_news.title }}</a></h2>
            <div class="news-lead">{{ gazda_news.description }}</div>
          </div>
        </article>
      </section>
    {% endif %}

    <div class="separator" role="heading" aria-level="2"><div class="separator-line"></div><div class="separator-icon"><img src="{{ asset_path }}/images/separators/sep-sun-2.png" alt=""></div><div class="separator-text">{{ 'Vásárlóink mondták'|t }}</div><div class="separator-line"></div></div>
    <a class="google-rating-summary" href="https://www.google.com/search?q=gazdabolt+szentendre" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Google-értékelés: 4,8 az 5-ből, 267 értékelés alapján'|t }}">
      <span class="google-rating-summary__source">Google</span>
      <strong class="google-rating-summary__score">4,8</strong>
      <span class="google-rating-summary__stars" aria-hidden="true">★★★★★</span>
      <span class="google-rating-summary__count">{{ '267 értékelés'|t }}</span>
    </a>
    {% set google_reviews = [
      { name: 'Tina Dr.', initial: 'T', rating: 5, stars: '★★★★★', date: '2026-06-27', date_display: '2026. június 27.', text: 'Szinte minden kapható, szezonális termékek is. A kiszolgálás mindig nagyon segítőkész és kedves. Könnyen megközelíthető helyen van.' },
      { name: 'Lászlo Szabó', initial: 'L', rating: 4, stars: '★★★★☆', date: '2026-04-03', date_display: '2026. április 3.', text: 'Rengeteg mindent lehet kapni. Ajánlom. Csavarok,petmetszerek,konyhafelszerelés,vetőmag, palánta,viragföld stb.' },
      { name: 'Julia B.', initial: 'J', rating: 5, stars: '★★★★★', date: '2026-01-03', date_display: '2026. január 3.', text: 'Szeretünk ide járni - mindig nagyon kedvesek. Örülünk, hogy egy kis vállalkozást támogathatunk! :) Egyébként szerintem árban is sokszor jobban megéri, mint az Obi vagy a Bauhaus.' },
      { name: 'Ervin Tóth', initial: 'E', rating: 5, stars: '★★★★★', date: '2025-09-30', date_display: '2025. szeptember 30.', text: 'Ha Szentendrén járok, mindig bemegyek, mert olyan nosztalgikus vidéki gazdabolt filingje van. Pöttyös fazéktól kezdve minden kapható, amit egy kis falusi bolt árusított.' },
      { name: 'Tamas Petro', initial: 'T', rating: 5, stars: '★★★★★', date: '2018-12-31', date_display: '2018. december 31.', text: 'Jók a srácok. Kertészeti témában jó tanacsokat tudnak adni. Elég vinni egy képet a növényről és próbálnak segíteni. Nekem eddig mindíg bejött. + Az ellenszert, tápszert meg is tudtam venni. Jobb mint egy multinál olvasgatni a használati útmutatót a sorok között. Ajánlom őket.' }
    ] %}
    <section id="customer-reviews" aria-label="{{ 'Customer reviews'|t }}">
      {% for review in google_reviews %}
        <article class="customer-review google-review">
          <div class="google-review__header">
            <span class="google-review__avatar" aria-hidden="true">{{ review.initial }}</span>
            <div class="google-review__author">
              <h3 class="customer-name">{{ review.name }}</h3>
              <time datetime="{{ review.date }}">{{ review.date_display }}</time>
            </div>
          </div>
          <div class="google-review__rating">
            <span class="google-review__stars" aria-hidden="true">{{ review.stars }}</span>
            <span class="visually-hidden">{{ review.rating }} {{ 'csillag az 5-ből'|t }}</span>
          </div>
          <div class="customer-review-text">{{ review.text }}</div>
        </article>
      {% endfor %}
    </section>
  </div>
</main>
{% endblock %}
