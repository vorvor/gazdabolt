<?php

/**
 * @file
 * Theme hooks and preprocessors for the Gazda theme.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_preprocess_page().
 */
function gazda_preprocess_page(array &$variables): void {
  if (empty($variables['is_front'])) {
    return;
  }

  $variables['gazda_discount'] = NULL;
  $variables['gazda_categories'] = [];
  $variables['gazda_current_news'] = NULL;
  $variables['gazda_news'] = NULL;
  $variables['gazda_reviews'] = [];
  $entity_type_manager = \Drupal::entityTypeManager();
  $node_storage = $entity_type_manager->getStorage('node');
  $view_builder = $entity_type_manager->getViewBuilder('node');
  (new CacheableMetadata())
    ->setCacheTags($node_storage->getEntityType()->getListCacheTags())
    ->applyTo($variables);

  $discount_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'discount')
    ->condition('status', 1)
    ->sort('field_date_from', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();

  if ($discount_ids && ($discount = $node_storage->load(reset($discount_ids)))) {
    $months = [
      1 => 'január',
      2 => 'február',
      3 => 'március',
      4 => 'április',
      5 => 'május',
      6 => 'június',
      7 => 'július',
      8 => 'augusztus',
      9 => 'szeptember',
      10 => 'október',
      11 => 'november',
      12 => 'december',
    ];
    $format_discount_date = static function ($item) use ($months): array {
      $date = $item->date;
      if (!$date) {
        return ['raw' => '', 'year_month' => '', 'day' => ''];
      }
      $month = $months[(int) $date->format('n')];
      return [
        'raw' => $item->value,
        'year_month' => $date->format('Y') . '. ' . $month,
        'day' => $date->format('j'),
      ];
    };

    $variables['gazda_discount'] = [
      'rate' => (int) $discount->get('field_discount_rate')->value,
      'description' => $view_builder->viewField($discount->get('field_description'), [
        'label' => 'hidden',
        'type' => 'text_default',
      ]),
      'image' => $view_builder->viewField($discount->get('field_image'), [
        'label' => 'hidden',
        'type' => 'image',
        'settings' => [
          'image_link' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ]),
      'date_from' => $format_discount_date($discount->get('field_date_from')->first()),
      'date_to' => $format_discount_date($discount->get('field_date_to')->first()),
    ];
    CacheableMetadata::createFromObject($discount)->applyTo($variables);
  }

  $current_news_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'current_news')
    ->condition('status', 1)
    ->sort('field_date', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();

  if ($current_news_ids && ($current_news = $node_storage->load(reset($current_news_ids)))) {
    $months = [
      1 => 'január',
      2 => 'február',
      3 => 'március',
      4 => 'április',
      5 => 'május',
      6 => 'június',
      7 => 'július',
      8 => 'augusztus',
      9 => 'szeptember',
      10 => 'október',
      11 => 'november',
      12 => 'december',
    ];
    $date = $current_news->get('field_date')->date;
    $variables['gazda_current_news'] = [
      'title' => $current_news->label(),
      'description' => $view_builder->viewField($current_news->get('field_description'), [
        'label' => 'hidden',
        'type' => 'text_default',
      ]),
      'image' => $view_builder->viewField($current_news->get('field_image'), [
        'label' => 'hidden',
        'type' => 'image',
        'settings' => [
          'image_link' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ]),
      'date_raw' => $current_news->get('field_date')->value,
      'month' => $date ? $months[(int) $date->format('n')] : '',
    ];
    CacheableMetadata::createFromObject($current_news)->applyTo($variables);
  }

  $article_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->sort('field_date', 'DESC')
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->execute();

  if ($article_ids && ($article = $node_storage->load(reset($article_ids)))) {
    $date = $article->get('field_date')->date;
    $variables['gazda_news'] = [
      'title' => $article->label(),
      'url' => $article->toUrl()->toString(),
      'image' => $view_builder->viewField($article->get('field_image'), [
        'label' => 'hidden',
        'type' => 'image',
        'settings' => [
          'image_link' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ]),
      'description' => $view_builder->viewField($article->get('field_description'), [
        'label' => 'hidden',
        'type' => 'text_default',
      ]),
      'date_raw' => $article->get('field_date')->value,
      'date_display' => $date ? $date->format('Y. m. d.') : '',
    ];
    CacheableMetadata::createFromObject($article)->applyTo($variables);
  }

  $term_storage = $entity_type_manager->getStorage('taxonomy_term');
  $term_view_builder = $entity_type_manager->getViewBuilder('taxonomy_term');
  $term_ids = $term_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'categories')
    ->sort('weight', 'ASC')
    ->sort('name', 'ASC')
    ->execute();

  foreach ($term_storage->loadMultiple($term_ids) as $term) {
    $variables['gazda_categories'][] = [
      'name' => $term->label(),
      'url' => $term->toUrl()->toString(),
      'image' => $term_view_builder->viewField($term->get('field_image'), [
        'label' => 'hidden',
        'type' => 'image',
        'settings' => [
          'image_link' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ]),
    ];
    CacheableMetadata::createFromObject($term)->applyTo($variables);
  }
  (new CacheableMetadata())
    ->setCacheTags($term_storage->getEntityType()->getListCacheTags())
    ->applyTo($variables);

  $node_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'customers_said')
    ->condition('status', 1)
    ->sort('created', 'ASC')
    ->range(0, 3)
    ->execute();

  if (!$node_ids) {
    return;
  }

  foreach ($node_storage->loadMultiple($node_ids) as $node) {
    $image = $node->hasField('field_customer_image')
      ? $view_builder->viewField($node->get('field_customer_image'), [
        'label' => 'hidden',
        'type' => 'image',
        'settings' => [
          'image_link' => '',
          'image_loading' => ['attribute' => 'lazy'],
        ],
      ])
      : [];
    $description = $node->hasField('field_description')
      ? $view_builder->viewField($node->get('field_description'), [
        'label' => 'hidden',
        'type' => 'text_default',
      ])
      : [];
    $name = $node->hasField('field_customer_name') && !$node->get('field_customer_name')->isEmpty()
      ? $node->get('field_customer_name')->value
      : $node->label();

    $variables['gazda_reviews'][] = [
      'attributes' => new Attribute(['class' => ['customer-review']]),
      'image' => $image,
      'name' => $name,
      'description' => $description,
    ];
    CacheableMetadata::createFromObject($node)->applyTo($variables);
  }
}
